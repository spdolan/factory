      {
        "size": [
          "small"
        ],
        "state": "ready-to-spec"
      }
    ]
  },
  "claude_args": "",
  "conditions": [
    "breaking"
  ],
  "dry_run": false,
  "factory": {
    "ref": "refs/tags/v0.2",
    "release": "v0.2.0",
    "repo": "acme/factory",
    "sha": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  },
  "flag_sources": {
    "session-archive": "config.yml features.off",
    "skill-sources": "config.yml features.off",
    "spec-auto-advance": "config.yml features.off"
